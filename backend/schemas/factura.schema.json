{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fwd-contable-ai.local/schemas/factura.schema.json",
  "title": "Factura extraída por DocScan",
  "type": "object",
  "required": ["fuente", "confianza_extraccion", "requiere_revision_humana", "factura"],
  "properties": {
    "fuente": {
      "type": "string",
      "enum": ["pdf_nativo", "pdf_escaneado", "xml_hacienda"]
    },
    "confianza_extraccion": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requiere_revision_humana": { "type": "boolean" },
    "motivo_revision": {
      "type": ["string", "null"],
      "enum": [
        null,
        "OCR_DEGRADADO",
        "FACTURA_SIN_RECEPTOR",
        "CLAVE_NUMERICA_INVALIDA",
        "CEDULA_NO_REGISTRADA",
        "CEDULA_INACTIVA",
        "TARIFA_NO_RECONOCIBLE",
        "RECONCILIACION_FALLIDA",
        "MONEDA_DESCONOCIDA",
        "TIPO_CAMBIO_NO_DISPONIBLE",
        "DUPLICADA",
        "EXTRACCION_FALLIDA",
        "ENRIQUECIMIENTO_FALLIDO",
        "FECHA_ILEGIBLE",
        "FECHA_FUTURA",
        "FECHA_MUY_VIEJA",
        "FECHA_INVALIDA"
      ]
    },
    "factura": {
      "type": "object",
      "required": ["fecha_emision", "moneda", "proveedor", "lineas", "totales"],
      "properties": {
        "clave_numerica": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{50}$"
        },
        "consecutivo": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{20}$"
        },
        "tipo_documento": {
          "type": ["string", "null"],
          "enum": [null, "FE", "TE", "NC", "ND"]
        },
        "fecha_emision": {
          "type": "string",
          "format": "date"
        },
        "hora_emision": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$"
        },
        "moneda": {
          "type": "string",
          "enum": ["CRC", "USD", "EUR"]
        },
        "tipo_cambio": { "type": ["number", "null"] },
        "proveedor": {
          "type": "object",
          "required": ["nombre", "cedula"],
          "properties": {
            "nombre": { "type": "string" },
            "tipo_cedula": {
              "type": ["string", "null"],
              "enum": [null, "fisica", "juridica", "dimex", "nite"]
            },
            "cedula": { "type": "string" },
            "actividad_economica": { "type": ["string", "null"] }
          }
        },
        "receptor": {
          "type": ["object", "null"],
          "properties": {
            "nombre": { "type": "string" },
            "cedula": { "type": "string" }
          }
        },
        "lineas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["numero_linea", "descripcion", "cantidad", "precio_unitario", "monto_total"],
            "properties": {
              "numero_linea": { "type": "integer", "minimum": 1 },
              "codigo": { "type": ["string", "null"] },
              "descripcion": { "type": "string" },
              "cantidad": { "type": "number" },
              "unidad_medida": { "type": ["string", "null"] },
              "precio_unitario": { "type": "number" },
              "monto_total": { "type": "number" },
              "descuento": { "type": "number", "default": 0 },
              "tarifa_iva_marcada": {
                "type": ["number", "null"],
                "enum": [null, 0, 1, 2, 4, 13]
              },
              "tarifa_iva_inferida": {
                "type": ["number", "null"],
                "enum": [null, 0, 1, 2, 4, 13]
              },
              "iva_calculado": { "type": ["number", "null"] },
              "base_imponible": { "type": ["number", "null"] }
            }
          }
        },
        "totales": {
          "type": "object",
          "required": ["subtotal", "iva_total", "total_factura"],
          "properties": {
            "subtotal": { "type": "number" },
            "total_gravado": { "type": "number" },
            "total_exento": { "type": "number" },
            "total_exonerado": { "type": "number" },
            "descuento_total": { "type": "number" },
            "iva_por_tarifa": {
              "type": "object",
              "properties": {
                "0":  { "type": "number" },
                "1":  { "type": "number" },
                "2":  { "type": "number" },
                "4":  { "type": "number" },
                "13": { "type": "number" }
              }
            },
            "iva_total": { "type": "number" },
            "total_factura": { "type": "number" }
          }
        }
      }
    }
  }
}
