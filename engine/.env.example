# ============================================================
# FWD Contable AI — Engine .env.example
# Copiá este archivo como .env y rellená los valores reales.
# NO subir .env al repo (está en .gitignore).
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Autenticación de Claude ---
# Opción A: usar suscripción de Claude Code (Max plan) — NO requiere API key.
# El SDK detecta automáticamente el token de Claude Code instalado.
CLAUDE_AUTH_MODE=claude_code

# Opción B: si en algún momento querés usar API key directa, descomentá:
# CLAUDE_AUTH_MODE=api_key
# ANTHROPIC_API_KEY=sk-ant-...

# --- Base de datos SQLite ---
DB_PATH=./data/fwd-contable.db

# --- Google Sheets (Service Account) ---
# Se configura en Fase 2. Por ahora, dejá vacío.
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json
GOOGLE_SHEET_ID=

# --- Hacienda CR ---
# Endpoint público para validar cédulas (sin auth).
HACIENDA_PADRON_URL=https://api.hacienda.go.cr/fe/ae
# Endpoint público para consultar estado de factura (requiere token de Hacienda — fase 2).
HACIENDA_FE_API_URL=https://api.comprobanteselectronicos.go.cr
HACIENDA_FE_USER=
HACIENDA_FE_PASS=

# --- BCCR (tipo de cambio) ---
# Indicadores económicos del Banco Central. Necesita usuario y correo (gratis).
# https://gee.bccr.fi.cr/Indicadores/Suscripciones/WS/wsindicadoreseconomicos.asmx
BCCR_API_URL=https://gee.bccr.fi.cr/Indicadores/Suscripciones/WS/wsindicadoreseconomicos.asmx
BCCR_NOMBRE=
BCCR_EMAIL=
BCCR_TOKEN=

# --- Archivado de PDFs/XMLs procesados ---
STORAGE_PATH=./data/storage

# --- Logging ---
LOG_LEVEL=info
