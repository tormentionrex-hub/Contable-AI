# ============================================================
# FWD Contable AI — Engine .env.example
# Copiá este archivo como .env y rellená los valores reales.
# NO subir .env al repo (está en .gitignore).
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Autenticación de Claude ---
# Opción A: usar suscripción de Claude Code (Max plan) — NO requiere API key.
# El SDK detecta automáticamente el token de Claude Code instalado.
CLAUDE_AUTH_MODE=claude_code

# Opción B: si en algún momento querés usar API key directa, descomentá:
# CLAUDE_AUTH_MODE=api_key
# ANTHROPIC_API_KEY=sk-ant-...

# --- Base de datos SQLite ---
DB_PATH=./data/fwd-contable.db

# --- Google Sheets (Service Account) ---
# Se configura en Fase 2. Es gratis: el free tier de Google Cloud cubre
# 300 requests/minuto, muy por encima de lo que necesitamos.
# Pasos para generar el JSON: ver docs/PROMPT-FASE-2.md.
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json
# Dejar vacío en el primer arranque: el motor crea el Sheet automáticamente
# y guarda el ID en la tabla `empresas`. Después se puede pegar acá para acelerar boot.
GOOGLE_SHEET_ID_FUNDACION_CRC=
# Email del contador para compartirle el Sheet creado por la Service Account.
CONTADOR_EMAIL=

# --- Hacienda CR ---
# API pública oficial, SIN registro, SIN token, SIN tarjeta.
# Cubre tipo de cambio (USD/EUR), padrón de contribuyentes y CABYS.
# Probada en vivo: GET https://api.hacienda.go.cr/indicadores/tc/dolar
# Doc: https://api.hacienda.go.cr/docs/
HACIENDA_API_URL=https://api.hacienda.go.cr

# --- Fallback gratuito de tipo de cambio (si Hacienda devuelve 5xx) ---
# Ambos son públicos, sin key, sin rate limit documentado para uso normal.
HACIENDA_TC_FALLBACK_FAWAZ=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json
HACIENDA_TC_FALLBACK_FRANKFURTER=https://api.frankfurter.dev/v1/latest?from=USD&to=CRC

# --- Archivado de PDFs/XMLs procesados ---
STORAGE_PATH=./data/storage

# --- Logging ---
LOG_LEVEL=info
