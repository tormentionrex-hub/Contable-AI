{
  "name": "FWD-03-WhatsApp-Opcional",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fwd-whatsapp",
        "options": {}
      },
      "id": "webhook-wa",
      "name": "Webhook WhatsApp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "fwd-whatsapp",
      "notes": "Configurar la cuenta de WhatsApp Business Cloud API para que envíe los mensajes entrantes a este webhook (POST). Requiere conmuter token de verificación."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$json.body.entry[0].changes[0].value.messages[0].type}}",
              "rightValue": "text",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filtro-text",
      "name": "Solo mensajes de texto",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.FWD_BACKEND_URL}}/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{$env.FWD_SERVICE_USER}}\",\n  \"password\": \"{{$env.FWD_SERVICE_PASS}}\"\n}",
        "options": {}
      },
      "id": "auth-login",
      "name": "Login motor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.FWD_BACKEND_URL}}/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$json.token}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"mensaje\": \"{{$node['Webhook WhatsApp'].json.body.entry[0].changes[0].value.messages[0].text.body}}\",\n  \"empresa_id\": \"{{$env.FWD_EMPRESA_DEFAULT}}\",\n  \"incluir_historial\": true\n}",
        "options": { "timeout": 60000 }
      },
      "id": "post-chat",
      "name": "POST /chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{$env.WA_PHONE_NUMBER_ID}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.WA_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{$node['Webhook WhatsApp'].json.body.entry[0].changes[0].value.messages[0].from}}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"{{$json.respuesta.replace(/\\\"/g, '\\\\\\\"')}}\" }\n}",
        "options": {}
      },
      "id": "wa-reply",
      "name": "Enviar respuesta WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": {}
      },
      "id": "ack",
      "name": "ACK al webhook WhatsApp",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Webhook WhatsApp": { "main": [[{ "node": "Solo mensajes de texto", "type": "main", "index": 0 }]] },
    "Solo mensajes de texto": {
      "main": [
        [{ "node": "Login motor", "type": "main", "index": 0 }],
        [{ "node": "ACK al webhook WhatsApp", "type": "main", "index": 0 }]
      ]
    },
    "Login motor": { "main": [[{ "node": "POST /chat", "type": "main", "index": 0 }]] },
    "POST /chat": { "main": [[{ "node": "Enviar respuesta WhatsApp", "type": "main", "index": 0 }]] },
    "Enviar respuesta WhatsApp": { "main": [[{ "node": "ACK al webhook WhatsApp", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": {
    "instanceId": "fwd-contable-ai",
    "description": "OPCIONAL — requiere cuenta WhatsApp Business Cloud API (Meta Business). Variables: FWD_BACKEND_URL, FWD_SERVICE_USER, FWD_SERVICE_PASS, FWD_EMPRESA_DEFAULT, WA_PHONE_NUMBER_ID, WA_TOKEN."
  }
}
